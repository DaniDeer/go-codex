{
	"name": "go-codex",
	"image": "mcr.microsoft.com/devcontainers/go:1.27-trixie",
	"features": {
		"ghcr.io/danideer/devcontainer-features/install-ca-cert:1": {
			"cert_base64": "${localEnv:CERT_BASE64}",
			"cert_name": "${localEnv:CERT_NAME}"
		},
		"ghcr.io/devcontainers/features/copilot-cli:1": {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		},
		"ghcr.io/DaniDeer/devcontainer-features/just:1": {
			"version": "1.52.0"
		},
		"ghcr.io/azutake/devcontainer-features/go-packages-install:0": {
			// gosec is pinned to a commit, not v2.29.0: Go 1.27.2 bumped its
			// internal gc export-data format to version 5, which v2.29.0's
			// golang.org/x/tools v0.49.0 dependency cannot decode (every
			// stdlib/project import silently fails to type-check -- see
			// https://github.com/securego/gosec/issues/1774). This commit
			// (merged to gosec's master, not yet in a tagged release) carries
			// the x/tools bump that fixes it -- confirmed via a real gosec
			// run against this repo under go1.27.2 (0 import errors, 641
			// files checked, same as before the Go bump). Replace with the
			// next tagged gosec release once one ships containing this fix.
			"PACKAGES": "honnef.co/go/tools/cmd/staticcheck@v0.8.2,github.com/securego/gosec/v2/cmd/gosec@7b1b5cebe007d62fb58eacb90fc571112939ec30"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"go.useLanguageServer": true,
				"editor.formatOnSave": true,
				"[go]": {
					"editor.codeActionsOnSave": {
						"source.organizeImports": "always"
					}
				}
			},
			"extensions": [
				"golang.go",
				"eamodio.gitlens",
				"ms-azuretools.vscode-docker",
				"streetsidesoftware.code-spell-checker",
				"wayou.vscode-todo-highlight",
				"oderwat.indent-rainbow",
				"pnp.polacode",
				"esbenp.prettier-vscode"
			]
		}
	},

	"remoteUser": "vscode"
}
