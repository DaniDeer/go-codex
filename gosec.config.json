{
	"global": {
		"nosec": "enabled",
		"audit": "disabled"
	},
	"exclude-rules": [
		{
			"path": ".*",
			"rules": ["G301", "G304", "G306", "G703"]
		},
		{
			"path": "adapters/nethttp/cookie.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/client.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/binding.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/clienttransport.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/redirect.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/redirect_sse.go",
			"rules": ["G124"]
		},
		{
			"path": "adapters/nethttp/adapter.go",
			"rules": ["G705"]
		},
		{
			"path": "adapters/chi/adapter.go",
			"rules": ["G124", "G705"]
		},
		{
			"path": "examples/reqreply-api/demo_cross_api_oauth2_sharing.go",
			"rules": ["G101"]
		},
		{
			"path": "examples/reqreply-api/demo_bound_middleware_split.go",
			"rules": ["G101"]
		}
	]
}
